{
  "name": "@client-portal/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:all": "nx run-many -t serve -p shell dashboard reports --parallel=3",
    "start:shell": "nx serve shell",
    "start:dashboard": "nx serve dashboard",
    "start:reports": "nx serve reports",
    "build:all": "nx run-many -t build --parallel=3",
    "build:dashboard": "nx build dashboard",
    "build:reports": "nx build reports",
    "build:shell": "nx build shell",
    "test:all": "nx run-many -t test",
    "graph": "nx graph",
    "lint:all": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "format": "nx format:write --all",
    "format:uncommitted": "nx format:write --uncommitted",
    "format:check": "nx format:check --all",
    "build:gh-pages": "node tools/scripts/build-gh-pages.mjs",
    "check:circular": "madge --circular --extensions ts --ts-config tsconfig.base.json apps libs",
    "check:all": "pnpm format:check && pnpm lint:all && pnpm test:all && pnpm check:circular && pnpm build:all",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "es-module-shims": "2.8.0",
    "rxjs": "7.8.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "22.2.5",
    "@angular-devkit/core": "22.2.0",
    "@angular-devkit/schematics": "22.2.0",
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@angular/language-service": "22.2.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@nx/angular": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "22.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.58.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-preset-angular": "17.0.0",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.0",
    "madge": "8.0.0",
    "nx": "24.0.6",
    "prettier": "3.6.2",
    "ts-jest": "29.4.15",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs,html,scss,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
